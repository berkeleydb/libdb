# SUBSHELL and an `exitv=1' set inside one is lost when that subshell exits.
# That was defect U1: this script printed real failures and still exited 0, so
# dist/s_validate reported it as passing whatever it found.  A marker FILE
# survives the subshell; the parent consults it just before exiting.
failed=__chk_pubdef_failed
rm -f $failed

