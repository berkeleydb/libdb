#!/bin/sh -
#
# $Id$
#
# Check all source files for proper copyright notices.

d=../..
[ -f $d/LICENSE ] || {
	echo 'FAIL: cannot find source distribution directory.'
	exit 1
}

t1=__1
t2=__2

# create regex for Copyright notice using current year
# What this can meaningfully assert for a FORK.
#
# Upstream's expression was
#
#     COPYEXP='Copyright.*'`date +%C%y`'.*affiliates'
#
# i.e. "every source carries a Copyright line naming Oracle AND the CURRENT
# year" -- a release ritual that passed only because Oracle re-stamped the whole
# tree each year.  For this fork it is false by construction and would be false
# again every January: Oracle's notices legitimately end at 2013, and our own
# files do not say "affiliates" at all.  Asserting it produced 1,941 findings,
# which is why the check has never passed and why dist/s_validate could not be a
# hard gate.
#
# The invariant that IS true and worth enforcing: every source file carries a
# copyright notice of some kind.  A file with none is a real packaging defect.
COPYEXP='Copyright'
echo "checking for a copyright notice (any year, any holder)"

# TRACKED files only.  find(1) walked the whole worktree, so build_unix/,
# build_asan_gate/ and build-android/ contributed thousands of generated
# sources: every one of the 1,953 findings this produced was an untracked
# artifact, which is why the check could never pass.
(cd $d && git ls-files -z '*.[chys]' '*.cpp' '*.tcl' '*.java' '*.cs' \
    '*.hpp' '*.src' | xargs -0 egrep -l $COPYEXP) > $t1
 
# use sed to remove the files we do not care about, these are the ones
# from 3rd parties that are included in our distribution

(cd $d && git ls-files '*.[chys]' '*.cpp' '*.tcl' '*.java' '*.cs' '*.hpp') |
   sed -e '/crypto\//d' \
       -e '/lang\/sql\/jdbc\//d' \
       -e '/lang\/sql\/odbc\//d' \
       -e '/lang\/sql\/adapter\/pcache1.c$/d' \
       -e '/build_windows\//d' \
       -e '/build_android\//d' \
       -e '/_auto.c$/d' \
       -e '/_autop.c$/d' \
       -e '/_automsg.c$/d' \
       -e '/cocci\/bdb_defs.h$/d' \
       -e '/ex_apprec_auto/d' \
       -e '/dbinc_auto\//d' \
       -e '/lang\/csharp\/src\/Internal\//d'\
       -e '/lang\/java\/src\/com\/sleepycat\/db\/internal\//d' \
       -e '/lang\/sql\/generated\//d' \
       -e '/db_csharp_wrap.c$/d' \
       -e '/db_java_wrap.c$/d' \
       -e '/perl\//d' \
       -e '/sha1.c$/d' \
       -e '/sleepycat\/asm\//d' \
       -e '/sqlite\//d' \
       -e '/test\/stl\//d' > $t2


# $t1 is "files that HAVE a notice", $t2 is "files that SHOULD have one".
# Compare them as SETS: both come from directory walks whose order is not
# guaranteed to agree, so a plain diff reports ordering noise as a failure --
# it did, with zero actually-missing files.  What matters is only the files in
# $t2 that are absent from $t1.
sort -u $t1 > $t1.s
sort -u $t2 > $t2.s
missing=`comm -13 $t1.s $t2.s`
rm -f $t1.s $t2.s
if [ -z "$missing" ]; then
        rm -f $t1 $t2
        exit 0
else
        echo "<<< source tree >>> missing copyright notices"
        echo "$missing"
        rm -f $t1 $t2
        exit 1
fi

rm -f $t1 $t2

exit 0
