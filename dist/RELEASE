# $Id$

# ---------------------------------------------------------------------------
# CalVer release identity (calver.org) -- this is the version this FORK ships
# under, chosen to disambiguate the community continuation from every prior
# Sleepycat/Oracle Berkeley DB release (which used 5.3.x / 11.2.5.x / 18.1.x).
#
# Format: YYYY.0M  (append .MICRO for a same-month re-release, e.g. 2026.09.1).
# Bump YYYY.0M for the month you cut the release; MICRO for follow-ups.
# ---------------------------------------------------------------------------
DB_CALVER="2026.10.8"

# ---------------------------------------------------------------------------
# FORMAT / ABI COMPATIBILITY LEVEL (the triplet). It drives the shared-region
# attach check (majver/minver in env_region.c), the shared-object soname
# (libdb-MAJOR.MINOR.so via LIBVERSION), DB_VERSION_UNIQUE_NAME symbol mangling
# (_MAJORMINOR, zero-padded), and downstream packaging. It is NOT the release
# version: CalVer above is the release knob.
#
# Rule (rfc/0020, VERSIONING.md): on an LTS line it never moves. On master the
# MINOR moves when, and only when, the public ABI breaks (a public function
# signature, a public struct layout -- test/db/handle_sizes.c pins them -- or the
# meaning of a flag), and then with ABI-BREAK-INTENDED. Region-only, on-disk
# and log-format changes do not move it: the build signature and the
# per-format version numbers gate those.
#
# 2026.0.9 -> 2026.1.0 (rfc/0020): sizeof(DB) 1456 -> 1744 and DBC gained a
# field (cursor sharding, f9937fab5, KNOWN-ISSUES A1).
# ---------------------------------------------------------------------------
DB_VERSION_FAMILY=11
DB_VERSION_LETTER="g"
DB_VERSION_RELEASE=2
DB_VERSION_MAJOR=2026
DB_VERSION_MINOR=1
DB_VERSION_PATCH=0
DB_VERSION="$DB_VERSION_MAJOR.$DB_VERSION_MINOR.$DB_VERSION_PATCH"
DB_VERSION_FULL="$DB_VERSION_FAMILY.$DB_VERSION_RELEASE.$DB_VERSION_MAJOR.$DB_VERSION_MINOR.$DB_VERSION_PATCH"

DB_VERSION_UNIQUE_NAME=`printf "_%d%03d" $DB_VERSION_MAJOR $DB_VERSION_MINOR`

DB_RELEASE_DATE="October 30, 2026"
# User-facing string leads with the CalVer identity; the frozen 5.3.37 is kept
# as the parenthesised format/ABI compatibility level so tools that parse it
# and existing environments still see a stable compat number.
DB_VERSION_STRING="libdb $DB_CALVER ($DB_RELEASE_DATE)"
DB_VERSION_FULL_STRING="libdb $DB_CALVER ($DB_RELEASE_DATE)"
