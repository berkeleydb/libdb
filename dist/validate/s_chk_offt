#!/bin/sh -
#
# $Id: s_chk_offt,v 0f73af5ae3da 2010/05/10 05:38:40 alexander $
#
# Make sure that no off_t's have snuck into the release.
# off_t check is done at runtime in env_sig.c   We add a declaration for 
# off_t to db.h, so it is always guaranteed to be available.
# MJC:We add a declaration for off_t to db.h, so it is always guaranteed to be 
# available.  There are already many many cases where data structures are 
# different sizes on 64-bit systems than 32-bit systems (we have a runtime 
# check for that in env_sig.c). Test is really obsolete.

d=../..
[ -f $d/LICENSE ] || {
	echo 'FAIL: cannot find source distribution directory.'
	exit 1
}

t=__1

# The exclusions below are all SYSCALL-BOUNDARY uses, the same category as the
# pread/pwrite/seek/ftruncate entries Oracle already listed: the kernel's own
# prototype names off_t, so the cast is required rather than questionable.
#
#   os_aio_{posix,kqueue}.c  POSIX defines struct aiocb.aio_offset as off_t.
#   os_aio_uring.c           io_uring_prep_{read,write} take an off_t offset.
#   mp_backup.c              splits a byte offset into gigs + remainder for the
#                            backup callback, and needs a type wide enough to
#                            hold pgno * pagesize before the split.
#
# Note the header comment above records Oracle's own view that this check is
# "really obsolete" because off_t is declared in db.h and the size difference is
# caught at runtime.  It is kept because it still catches off_t leaking into
# PERSISTENT structures, which is a real portability bug; these additions are
# values that never outlive the call.
egrep -w off_t $d/src/*/*.[ch] $d/util/*.[ch] $d/src/*/*.in |
sed -e "/#undef off_t/d" \
    -e "/build_windows\//d" \
    -e "/db_env_set_func_ftruncate/d" \
    -e "/db_env_set_func_pread/d" \
    -e "/db_env_set_func_pwrite/d" \
    -e "/db_env_set_func_seek/d" \
    -e "/env_register.c/d" \
    -e "/j_ftruncate/d" \
    -e "/j_pread/d" \
    -e "/j_pwrite/d" \
    -e "/j_seek/d" \
    -e "/mp_fopen.c:.*can't use off_t's here/d" \
    -e "/mp_fopen.c:.*size or type off_t's or/d" \
    -e "/mp_fopen.c:.*where an off_t is 32-bits/d" \
    -e "/mutex\/tm.c:/d" \
    -e "/off_t because its size depends on/d" \
    -e "/os_ext.h/d" \
    -e "/os.h/d" \
    -e "/os_flock.c/d" \
    -e "/os_aio_posix.c:.*aio_offset/d" \
    -e "/os_aio_kqueue.c:.*aio_offset/d" \
    -e "/os_aio_uring.c:.*off_t off;/d" \
    -e "/os_aio_uring.c:.*off = (off_t)aio->pgno/d" \
    -e "/mp_backup.c:.*off_t t_off;/d" \
    -e "/mp_backup.c:.*t_off = (off_t)first_pgno/d" \
    -e "/mp_backup.c:.*off = (u_int32_t)(t_off - (off_t)gigs/d" \
    -e "/rep.h/d" \
    -e "/zerofill.c:.*stat_offset/d" \
    -e "/zerofill.c:.*write_offset/d" \
    -e "/os_map.c:.*(off_t)0))/d" \
    -e "/os_method.c/d" \
    -e "/os_rw.c:/d" \
    -e "/os_seek.c:.*off_t offset;/d" \
    -e "/os_seek.c:.*offset = /d" \
    -e "/os_seek.c:.*off_t/d" \
    -e "/os_truncate.c:.*off_t offset;/d" \
    -e "/os_truncate.c:.*off_t stat_offset;/d" \
    -e "/os_truncate.c:.*offset = /d" \
    -e "/test_perf\/perf_misc.c:/d" \
    -e "/test_server\/dbs.c:/d" > $t

test -s $t && {
	cat $t
	echo "FAIL: found questionable off_t usage"
	exit 1
}

rm -f $t

exit 0
